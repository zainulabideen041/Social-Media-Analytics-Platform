# ==================================
# Docker Environment Configuration
# ==================================
# Copy this to .env in Backend and Frontend directories for Docker setup

# ==================
# Backend (.env)
# ==================
NODE_ENV=development
PORT=5000

# MongoDB Configuration (Docker)
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/social_media_analytics?authSource=admin

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-123456
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-123456
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# ==================
# Frontend (.env)
# ==================
VITE_API_URL=http://localhost:5000/api
